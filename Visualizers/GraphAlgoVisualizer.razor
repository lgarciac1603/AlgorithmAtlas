@namespace AlgorithmAtlas.Visualizers
@using System.Globalization
@using AlgorithmAtlas.Models.Graphs
@using AlgorithmAtlas.Services.Graphs
@implements IDisposable

<MudPaper Class="pa-4 ga-visualizer" Outlined="true">
    <div class="d-flex align-center flex-wrap gap-2 mb-1">
        <MudText Typo="Typo.subtitle1">Try it: watch it search</MudText>
        <span class="ga-name" style="color:@Descriptor.Color">@Descriptor.Name</span>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="RunAsync" Disabled="_running">Run</MudButton>
        <MudButton Variant="Variant.Text" OnClick="ResetView" Disabled="_running">Reset</MudButton>
    </div>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Finding a path from <b>@Graph.Node(_scenario.Start).Label</b> to <b>@Graph.Node(_scenario.Goal).Label</b>.
        @if (Descriptor.Weighted)
        {
            <span>Edge labels are distances; the number under each node is its best known distance.</span>
        }
    </MudText>

    <div class="ga-frame">
        <svg class="ga-edges" width="100%" height="100%" preserveAspectRatio="none">
            @foreach (var e in Graph.Edges)
            {
                var a = Graph.Node(e.From);
                var b = Graph.Node(e.To);
                <line x1="@Pct(a.X)" y1="@Pct(a.Y)" x2="@Pct(b.X)" y2="@Pct(b.Y)"
                      class="ga-edge @EdgeClass(e.From, e.To)" />
            }
        </svg>

        @if (Descriptor.Weighted)
        {
            @foreach (var e in Graph.Edges)
            {
                var a = Graph.Node(e.From);
                var b = Graph.Node(e.To);
                <div class="ga-weight" style="left:@Pct((a.X + b.X) / 2); top:@Pct((a.Y + b.Y) / 2)">@e.Weight</div>
            }
        }

        @foreach (var n in Graph.Nodes)
        {
            <div class="ga-node @NodeClass(_nodeState[n.Id]) @Endpoint(n.Id)"
                 style="left:@Pct(n.X); top:@Pct(n.Y)" @key="n.Id">
                <span class="ga-node-label">@n.Label</span>
                @if (Descriptor.Weighted && !double.IsPositiveInfinity(_dist[n.Id]))
                {
                    <span class="ga-node-dist">@((int)_dist[n.Id])</span>
                }
            </div>
        }
    </div>

    <div class="ga-legend">
        <span class="ga-legend-item"><i class="dot frontier"></i>frontier</span>
        <span class="ga-legend-item"><i class="dot current"></i>visiting</span>
        <span class="ga-legend-item"><i class="dot visited"></i>visited</span>
        <span class="ga-legend-item"><i class="dot path"></i>path</span>
    </div>

    <div class="ga-foot">
        <span>time <code>@Descriptor.TimeComplexity</code></span>
        <span>space <code>@Descriptor.SpaceComplexity</code></span>
        <span>visited @_visitedCount</span>
        @if (_finished)
        {
            <span>path @_pathHops hop@(_pathHops == 1 ? "" : "s")</span>
            @if (Descriptor.Weighted)
            {
                <span>cost @_pathCost</span>
            }
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public GraphDescriptor Descriptor { get; set; } = null!;
    [Parameter] public int StepDelayMs { get; set; } = 500;

    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private readonly GraphScenario _scenario = GraphSamples.Pathfinding();
    private GraphModel Graph => _scenario.Graph;

    private Dictionary<int, NodeState> _nodeState = new();
    private Dictionary<int, double> _dist = new();
    private readonly Dictionary<(int, int), EdgeState> _edgeState = new();

    private int _current = -1;
    private int _visitedCount;
    private int _pathHops;
    private int _pathCost;
    private bool _running;
    private bool _finished;
    private CancellationTokenSource? _cts;

    private enum NodeState { Idle, Frontier, Current, Visited, Path }
    private enum EdgeState { Idle, Explored, Path }

    public bool IsRunning => _running;

    protected override void OnInitialized() => LoadView();

    private void LoadView()
    {
        _nodeState = Graph.Nodes.ToDictionary(n => n.Id, _ => NodeState.Idle);
        _dist = Graph.Nodes.ToDictionary(n => n.Id, _ => double.PositiveInfinity);
        _edgeState.Clear();
        _current = -1;
        _visitedCount = 0;
        _pathHops = 0;
        _pathCost = 0;
        _finished = false;
    }

    /// <summary>Reset to the initial graph without running.</summary>
    public void ResetView()
    {
        Cancel();
        LoadView();
        StateHasChanged();
    }

    /// <summary>Replay the search on the demo graph, animating each step.</summary>
    public async Task RunAsync()
    {
        Cancel();
        LoadView();
        _running = true;
        var token = (_cts = new CancellationTokenSource()).Token;

        var steps = Descriptor.Run(Graph, _scenario.Start, _scenario.Goal).ToList();
        StateHasChanged();

        try
        {
            foreach (var step in steps)
            {
                if (token.IsCancellationRequested) return;
                Apply(step);
                StateHasChanged();
                await Task.Delay(StepDelayMs, token);
            }
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _running = false;
        _finished = true;
        StateHasChanged();
    }

    public void Cancel()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        _running = false;
    }

    private void Apply(GraphStep step)
    {
        switch (step.Kind)
        {
            case GraphStepKind.Discover:
                if (_nodeState[step.Node] == NodeState.Idle)
                {
                    _nodeState[step.Node] = NodeState.Frontier;
                }
                if (Descriptor.Weighted)
                {
                    _dist[step.Node] = step.Distance;
                }
                SetEdge(step.From, step.Node, EdgeState.Explored);
                break;

            case GraphStepKind.Visit:
                if (_current >= 0 && _nodeState[_current] == NodeState.Current)
                {
                    _nodeState[_current] = NodeState.Visited;
                }
                _nodeState[step.Node] = NodeState.Current;
                _current = step.Node;
                _visitedCount++;
                break;

            case GraphStepKind.Relax:
                if (_nodeState[step.Node] is not (NodeState.Visited or NodeState.Current))
                {
                    _nodeState[step.Node] = NodeState.Frontier;
                }
                _dist[step.Node] = step.Distance;
                SetEdge(step.From, step.Node, EdgeState.Explored);
                break;

            case GraphStepKind.Path:
                _nodeState[step.Node] = NodeState.Path;
                SetEdge(step.From, step.Node, EdgeState.Path);
                if (step.From >= 0)
                {
                    _pathHops++;
                }
                if (Descriptor.Weighted && !double.IsPositiveInfinity(_dist[step.Node]))
                {
                    _pathCost = (int)_dist[step.Node];
                }
                break;

            case GraphStepKind.Done:
                if (_current >= 0 && _nodeState[_current] == NodeState.Current)
                {
                    _nodeState[_current] = NodeState.Visited;
                }
                break;
        }
    }

    private static (int, int) Key(int a, int b) => a < b ? (a, b) : (b, a);

    private void SetEdge(int a, int b, EdgeState s)
    {
        if (a < 0 || b < 0) return;
        _edgeState[Key(a, b)] = s;
    }

    private string EdgeClass(int a, int b) =>
        _edgeState.TryGetValue(Key(a, b), out var s) ? s switch
        {
            EdgeState.Explored => "explored",
            EdgeState.Path => "path",
            _ => ""
        } : "";

    private static string NodeClass(NodeState s) => s switch
    {
        NodeState.Frontier => "frontier",
        NodeState.Current => "current",
        NodeState.Visited => "visited",
        NodeState.Path => "path",
        _ => "idle"
    };

    private string Endpoint(int id) =>
        id == _scenario.Start ? "start" : id == _scenario.Goal ? "goal" : "";

    private static string Pct(double v) => v.ToString(Inv) + "%";

    public void Dispose() => Cancel();
}
