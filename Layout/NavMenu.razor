@inject AlgorithmService AlgorithmService

<MudNavMenu Class="pa-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="compare" Icon="@Icons.Material.Filled.Leaderboard">Sorting Race</MudNavLink>
    <MudText Typo="Typo.overline" Class="px-4 mt-4 mud-text-secondary">Categories</MudText>
    @if (_categories is null)
    {
        <MudNavLink Disabled="true">Loading…</MudNavLink>
    }
    else
    {
        @foreach (var category in _categories)
        {
            <MudNavLink Href="@($"category/{Uri.EscapeDataString(category)}")" Icon="@CategoryIcon(category)">
                @category
            </MudNavLink>
        }
    }
</MudNavMenu>

@code {
    private List<string>? _categories;

    protected override async Task OnInitializedAsync()
    {
        _categories = await AlgorithmService.GetCategoriesAsync();
    }

    private static string CategoryIcon(string category) => category switch
    {
        "Data Structures" => Icons.Material.Filled.AccountTree,
        "Sorting" => Icons.Material.Filled.SortByAlpha,
        "Searching" => Icons.Material.Filled.Search,
        "Graph" => Icons.Material.Filled.Hub,
        "Neural Networks" => Icons.Material.Filled.Psychology,
        _ => Icons.Material.Filled.Category
    };
}
