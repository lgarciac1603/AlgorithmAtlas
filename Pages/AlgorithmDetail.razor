@page "/algorithm/{Id}"
@inject AlgorithmService AlgorithmService
@using Markdig
@using AlgorithmAtlas.Services.Sorting
@using AlgorithmAtlas.Services.Graphs
@using AlgorithmAtlas.Visualizers

<PageTitle>@(_algorithm?.Name ?? "Algorithm") — AlgorithmAtlas</PageTitle>

@if (_algorithm is null)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudBreadcrumbs Items="_breadcrumbs" Class="px-0 mb-2" />

    <div class="d-flex align-center flex-wrap gap-2 mb-2">
        <MudText Typo="Typo.h3">@_algorithm.Name</MudText>
        <MudChip T="string" Color="@DifficultyColor(_algorithm.Difficulty)" Variant="Variant.Filled">@_algorithm.Difficulty</MudChip>
    </div>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">@_algorithm.Description</MudText>

    @if (HasVisualizer(Id))
    {
        <div class="mb-6">
            @switch (Id)
            {
                case "stack":
                    <StackVisualizer />
                    break;
                case "queue":
                    <QueueVisualizer />
                    break;
                case "array":
                    <ArrayVisualizer />
                    break;
                case "linked-list":
                    <LinkedListVisualizer />
                    break;
                case "hash-table":
                    <HashTableVisualizer />
                    break;
                case "binary-tree":
                    <BinaryTreeVisualizer />
                    break;
                case "avl-tree":
                    <AvlTreeVisualizer />
                    break;
                case "binary-heap":
                    <BinaryHeapVisualizer />
                    break;
                case "trie":
                    <TrieVisualizer />
                    break;
                case "graph":
                    <GraphVisualizer />
                    break;
                case "skip-list":
                    <SkipListVisualizer />
                    break;
                case "neural-network":
                    <NeuralNetVisualizer />
                    break;
                case "k-means":
                    <KMeansVisualizer />
                    break;
            }
        </div>
    }

    @if (_graphDescriptor is not null)
    {
        <div class="mb-6">
            <GraphAlgoVisualizer Descriptor="_graphDescriptor" />
        </div>
    }

    @if (_sortDescriptor is not null)
    {
        <MudPaper Class="pa-4 mb-6" Outlined="true">
            <div class="d-flex align-center flex-wrap gap-2 mb-3">
                <MudText Typo="Typo.subtitle1">Try it: watch it sort</MudText>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_sortSound" Color="Color.Primary">Sound</MudSwitch>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="RunSort">Run</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ShuffleSort">Shuffle</MudButton>
                <MudButton Variant="Variant.Text" Href="compare">Compare with others →</MudButton>
            </div>
            <SortVisualizer @ref="_sortVis" Descriptor="_sortDescriptor" Data="_sortData"
                            StepDelayMs="45" Sounds="_sortSound" ShowComplexity="true" />
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" md="8">
            @if (_contentHtml is not null)
            {
                <div class="markdown-body">
                    @((MarkupString)_contentHtml)
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    A detailed explanation for this algorithm is coming soon.
                </MudAlert>
            }
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Complexity</MudText>
                <div class="complexity-summary mb-3">
                    <div><span class="mud-text-secondary">Time</span><code>@_algorithm.TimeComplexity</code></div>
                    <div><span class="mud-text-secondary">Space</span><code>@_algorithm.SpaceComplexity</code></div>
                </div>

                @if (_algorithm.Operations is { Count: > 0 })
                {
                    <MudDivider Class="mb-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Operations</MudText>
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            @foreach (var (op, complexity) in _algorithm.Operations)
                            {
                                <tr>
                                    <td>@op</td>
                                    <td><code>@complexity</code></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private Algorithm? _algorithm;
    private string? _contentHtml;
    private List<BreadcrumbItem> _breadcrumbs = [];

    private GraphDescriptor? _graphDescriptor;
    private SortDescriptor? _sortDescriptor;
    private SortVisualizer? _sortVis;
    private int[] _sortData = [];
    private bool _sortSound = true;
    private readonly Random _sortRng = new();

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override async Task OnParametersSetAsync()
    {
        _algorithm = await AlgorithmService.GetByIdAsync(Id);
        if (_algorithm is null)
        {
            return;
        }

        var markdown = await AlgorithmService.GetContentAsync(Id);
        _contentHtml = markdown is null ? null : Markdown.ToHtml(markdown, Pipeline);

        _breadcrumbs =
        [
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem(_algorithm.Category, href: $"category/{Uri.EscapeDataString(_algorithm.Category)}"),
            new BreadcrumbItem(_algorithm.Name, href: null, disabled: true)
        ];

        _graphDescriptor = GraphRegistry.Get(Id);

        _sortDescriptor = SortRegistry.Get(Id);
        if (_sortDescriptor is not null && _sortData.Length == 0)
        {
            GenerateSortData();
        }
    }

    private void GenerateSortData()
    {
        var data = new int[28];
        for (var i = 0; i < data.Length; i++)
        {
            data[i] = _sortRng.Next(5, 100);
        }
        _sortData = data;
    }

    private void ShuffleSort()
    {
        GenerateSortData();
        _sortVis?.ResetView();
    }

    private async Task RunSort()
    {
        if (_sortVis is not null)
        {
            await _sortVis.RunAsync();
        }
    }

    private static bool HasVisualizer(string id) => id is
        "stack" or "queue" or "array" or "linked-list" or "hash-table"
        or "binary-tree" or "avl-tree" or "binary-heap" or "trie" or "graph"
        or "skip-list" or "neural-network" or "k-means";

    private static Color DifficultyColor(string difficulty) => difficulty switch
    {
        "Easy" => Color.Success,
        "Medium" => Color.Warning,
        "Hard" => Color.Error,
        _ => Color.Default
    };
}
